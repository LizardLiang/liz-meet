{
  "name": "electron-vite-react-boilerplate",
  "private": true,
  "version": "1.0.0",
  "description": "A modern Electron application boilerplate built with Vite, React, TypeScript, and DaisyUI",
  "author": "Your Name <your.email@example.com>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:ci": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:transcript": "bun scripts/test-transcript.ts",
    "postinstall": "electron-rebuild -f -w better-sqlite3,naudiodon2 || true"
  },
  "dependencies": {
    "@electron/rebuild": "^4.0.4",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-virtual": "^3.13.24",
    "better-sqlite3": "^12.9.0",
    "daisyui": "^5.0.47",
    "electron-audio-loopback": "^1.0.6",
    "electron-updater": "^6.6.2",
    "naudiodon2": "^2.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.14.2",
    "tailwindcss": "^4.1.11",
    "wav": "^1.0.2",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/wav": "^1.0.4",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^35.7.5",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^7.1.5",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.5"
  },
  "main": "dist-electron/main.js"
}
